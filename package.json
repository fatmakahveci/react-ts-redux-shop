{
  "name": "react-ts-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "emulators": "npx --yes firebase-tools@15.28.2 emulators:start --only database --project demo-redux-cart",
    "test:e2e:emulator": "FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000 FIREBASE_PROJECT_ID=demo-redux-cart npx --yes firebase-tools@15.28.2 emulators:exec --only database --project demo-redux-cart \"npm run test:e2e\"",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "jsdom": "30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
